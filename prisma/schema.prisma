generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  clerkId     String   @unique
  name        String?
  email       String   @unique
  streakCount    Int      @default(0)
  longestStreak  Int      @default(0)
  lastPracticeAt DateTime?
  createdAt      DateTime @default(now())
  history     GrammarCheckHistory[]
  quizzes     QuizAttempt[]
  bookmarks   Bookmark[]
}

model GrammarCheckHistory {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  originalText    String
  correctedText   String
  mistakes        Json
  score           Int      @default(0)
  scoreExplanation String?
  createdAt       DateTime @default(now())
}

model QuizAttempt {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  topic          String
  difficulty     String
  score          Int
  totalQuestions Int
  createdAt      DateTime @default(now())
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  ruleTopic String
  savedAt   DateTime @default(now())
}

model DailyChallenge {
  id           String   @id @default(uuid())
  date         DateTime @unique
  wordOfDay    String
  grammarRule  String
  quizJson     Json
}
